  "nodes": [
    {
      "id": "n_open",
      "speaker": "xo",
      "trigger": {
        "always": true
      },
      "priority": 8,
      "text": "Station-keeping off our port quarter, Captain. She'll hold twelve knots and she will not turn for anybody. Weapons tight. Traffic in the strait at this hour is almost all civilian.",
      "focus": [
        "c_argo"
      ]
    },
    {
      "id": "n_open_cic",
      "speaker": "cic",
      "trigger": {
        "timeAfter": 14
      },
      "text": "Scope is clean apart from the usual. Fishing traffic working the shoals to the north, one friendly on the surveillance track. I'll call anything that behaves."
    },
    {
      "id": "n_orion_check",
      "speaker": "esm",
      "trigger": {
        "contactDetected": {
          "id": "c_orion"
        }
      },
      "text": "Search radar on the high track, Captain. That emitter is ours \u2014 I have it in the library and it hasn't changed in ten years.",
      "focus": [
        "c_orion"
      ]
    },
    {
      "id": "n_dhow_first",
      "speaker": "cic",
      "trigger": {
        "contactWithin": {
          "id": "c_dhow_1",
          "nm": 20
        }
      },
      "text": "Slow surface track crossing right to left ahead of the tanker. Small return. Reads like the fishing traffic we saw on the way in.",
      "focus": [
        "c_dhow_1"
      ]
    },
    {
      "id": "n_dhow_choice",
      "speaker": "tao",
      "trigger": {
        "all": [
          {
            "contactWithin": {
              "id": "c_dhow_1",
              "nm": 15
            }
          },
          {
            "not": {
              "flag": "dhow_1_handled",
              "is": true
            }
          }
        ]
      },
      "text": "Crossing traffic ahead of our charge, Captain. How do you want it worked?",
      "focus": [
        "c_dhow_1",
        "c_argo"
      ],
      "timeoutSeconds": 20,
      "defaultOption": "o_dhow_watch",
      "options": [
        {
          "id": "o_dhow_hail",
          "text": "Hail her. Bridge to bridge.",
          "requires": {
            "contactWithin": {
              "id": "c_dhow_1",
              "nm": 20
            }
          },
          "effects": [
            {
              "setFlag": {
                "key": "dhow_1_handled",
                "value": true
              }
            },
            {
              "setFlag": {
                "key": "dhow_1_hailed",
                "value": true
              }
            },
            {
              "queueNode": {
                "nodeId": "n_dhow_silent",
                "afterSeconds": 18
              }
            }
          ]
        },
        {
          "id": "o_dhow_illuminate",
          "text": "Paint her. I want her to know we're here.",
          "requires": {
            "contactWithin": {
              "id": "c_dhow_1",
              "nm": 20
            }
          },
          "effects": [
            {
              "setFlag": {
                "key": "dhow_1_handled",
                "value": true
              }
            },
            {
              "setFlag": {
                "key": "painted_a_fisherman",
                "value": true
              }
            },
            {
              "queueNode": {
                "nodeId": "n_dhow_scatter",
                "afterSeconds": 10
              }
            }
          ]
        },
        {
          "id": "o_dhow_watch",
          "text": "Leave her alone. Keep the track.",
          "effects": [
            {
              "setFlag": {
                "key": "dhow_1_handled",
                "value": true
              }
            }
          ]
        }
      ]
    },
    {
      "id": "n_dhow_silent",
      "speaker": "cic",
      "trigger": {
        "flag": "never_fires_on_its_own",
        "is": true
      },
      "text": "Nothing back on any channel, Captain. Half of them don't carry a set and the other half don't answer a warship. Not a reading either way."
    },
    {
      "id": "n_dhow_scatter",
      "speaker": "xo",
      "trigger": {
        "flag": "never_fires_on_its_own",
        "is": true
      },
      "text": "She's turning north and going flat out, which is what a fisherman does with a fire-control beam on him. We'll be in the tea houses in Bandar Lengeh by Thursday."
    },
    {
      "id": "n_argo_master",
      "speaker": "argo",
      "trigger": {
        "timeAfter": 240
      },
      "text": "VALLEY FORGE, ARGO SPIRIT. We are holding course and speed as briefed. Master requests you stay off our starboard side; we have a blind arc there and I'd rather not lose you.",
      "focus": [
        "c_argo"
      ]
    },
    {
      "id": "n_air_detect",
      "speaker": "cic",
      "trigger": {
        "contactDetected": {
          "id": "c_airbus"
        }
      },
      "text": "New air track out of the north-west, climbing. Big return for a single aircraft.",
      "focus": [
        "c_airbus"
      ]
    },
    {
      "id": "n_air_tao_push",
      "speaker": "tao",
      "trigger": {
        "all": [
          {
            "contactWithin": {
              "id": "c_airbus",
              "nm": 60
            }
          },
          {
            "not": {
              "flag": "air_resolved",
              "is": true
            }
          }
        ]
      },
      "priority": 7,
      "text": "Captain, that track is inside sixty and I do not have a squawk I trust. I want an SM-2 on the rail before it gets any closer.",
      "focus": [
        "c_airbus"
      ]
    },
    {
      "id": "n_air_xo_doubt",
      "speaker": "xo",
      "trigger": {
        "nodeFired": "n_air_tao_push"
      },
      "priority": 7,
      "text": "Before we do that \u2014 there is a published departure out of Bandar Abbas that runs right down this corridor at exactly this hour, Captain. I'd interrogate it before I got excited."
    },
    {
      "id": "n_air_choice",
      "speaker": "tao",
      "trigger": {
        "all": [
          {
            "contactWithin": {
              "id": "c_airbus",
              "nm": 45
            }
          },
          {
            "not": {
              "flag": "air_resolved",
              "is": true
            }
          }
        ]
      },
      "priority": 8,
      "text": "It's closing. Orders, Captain.",
      "focus": [
        "c_airbus",
        "c_argo"
      ],
      "timeoutSeconds": 18,
      "defaultOption": "o_air_track",
      "options": [
        {
          "id": "o_air_track",
          "text": "Keep tracking. Work the ladder.",
          "effects": [
            {
              "setFlag": {
                "key": "air_resolved",
                "value": true
              }
            }
          ]
        },
        {
          "id": "o_air_warn",
          "text": "Warning call on guard. All frequencies.",
          "requires": {
            "contactWithin": {
              "id": "c_airbus",
              "nm": 50
            }
          },
          "effects": [
            {
              "setFlag": {
