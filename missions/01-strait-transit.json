                "value": true
              }
            },
            {
              "queueNode": {
                "nodeId": "n_air_reply",
                "afterSeconds": 12
              }
            }
          ]
        },
        {
          "id": "o_air_illuminate",
          "text": "Illuminate. Put a lock on it.",
          "requires": {
            "contactWithin": {
              "id": "c_airbus",
              "nm": 60
            }
          },
          "effects": [
            {
              "setFlag": {
                "key": "air_resolved",
                "value": true
              }
            },
            {
              "setFlag": {
                "key": "air_illuminated",
                "value": true
              }
            },
            {
              "queueNode": {
                "nodeId": "n_air_locked",
                "afterSeconds": 8
              }
            }
          ]
        },
        {
          "id": "o_air_free",
          "text": "Request weapons release on that track.",
          "requires": {
            "contactClassified": {
              "id": "c_airbus",
              "min": 75
            }
          },
          "effects": [
            {
              "setFlag": {
                "key": "air_resolved",
                "value": true
              }
            },
            {
              "setFlag": {
                "key": "requested_release_on_air",
                "value": true
              }
            },
            {
              "queueNode": {
                "nodeId": "n_air_fleet_denies",
                "afterSeconds": 6
              }
            }
          ]
        }
      ]
    },
    {
      "id": "n_air_reply",
      "speaker": "cic",
      "trigger": {
        "flag": "never_fires_on_its_own",
        "is": true
      },
      "text": "Got a reply on guard, Captain. English, accented, very calm. Reading off a flight number and a routing. Sounds exactly like a man who has done this four hundred times."
    },
    {
      "id": "n_air_locked",
      "speaker": "esm",
      "trigger": {
        "flag": "never_fires_on_its_own",
        "is": true
      },
      "text": "We're locked on. No reaction from the track at all \u2014 no jink, no jamming, no defensive emission. It just kept climbing on the same heading."
    },
    {
      "id": "n_air_fleet_denies",
      "speaker": "fleet",
      "trigger": {
        "flag": "never_fires_on_its_own",
        "is": true
      },
      "priority": 9,
      "text": "VALLEY FORGE, release is denied on that track. Corridor is active. Resolve it with something other than a missile."
    },
    {
      "id": "n_air_past",
      "speaker": "cic",
      "trigger": {
        "all": [
          {
            "flag": "air_resolved",
            "is": true
          },
          {
            "not": {
              "contactWithin": {
                "id": "c_airbus",
                "nm": 45
              }
            }
          }
        ]
      },
      "text": "Air track is through and opening. Still climbing, never deviated. Whatever it is, it was going somewhere and it got there."
    },
    {
      "id": "n_dhow_2_detect",
      "speaker": "cic",
      "trigger": {
        "contactDetected": {
          "id": "c_dhow_2"
        }
      },
      "text": "Second slow surface track south-east of the lane. Same return as the first one.",
      "focus": [
        "c_dhow_2"
      ]
    },
    {
      "id": "n_fiac_detect",
      "speaker": "cic",
      "trigger": {
        "contactDetected": {
          "id": "c_fiac_1"
        }
      },
      "priority": 7,
      "text": "New surface track to the east. Small return \u2014 the profile library calls it a fishing vessel. Captain, it is not moving like one.",
      "focus": [
        "c_fiac_1"
      ]
    },
    {
      "id": "n_fiac_xo",
      "speaker": "xo",
      "trigger": {
        "nodeFired": "n_fiac_detect"
      },
      "text": "Nothing out here does that speed for a living. Either a smuggler is having a bad night or somebody wants to see how close they can get."
    },
    {
      "id": "n_fiac_choice",
      "speaker": "tao",
      "trigger": {
        "all": [
          {
            "contactWithin": {
              "id": "c_fiac_1",
              "nm": 20
            }
          },
          {
            "not": {
              "flag": "fiac_resolved",
              "is": true
            }
          }
        ]
      },
      "priority": 8,
      "text": "Captain, I have a contact closing the tanker. Your call.",
      "focus": [
        "c_fiac_1",
        "c_argo"
      ],
      "timeoutSeconds": 15,
      "defaultOption": "o_fiac_wait",
      "options": [
        {
          "id": "o_fiac_illuminate",
          "text": "Illuminate. Let him know we see him.",
          "requires": {
            "contactWithin": {
              "id": "c_fiac_1",
              "nm": 25
            }
          },
          "effects": [
            {
              "setFlag": {
                "key": "fiac_resolved",
                "value": true
              }
            },
            {
              "setFlag": {
                "key": "fiac_illuminated",
                "value": true
              }
            },
            {
              "queueNode": {
                "nodeId": "n_fiac_no_flinch",
                "afterSeconds": 9
              }
            }
          ]
        },
        {
          "id": "o_fiac_hail",
          "text": "Hail him first. Bridge to bridge, all channels.",
          "requires": {
            "contactWithin": {
              "id": "c_fiac_1",
              "nm": 25
            }
          },
          "effects": [
            {
              "setFlag": {
                "key": "fiac_resolved",
                "value": true
              }
            },
            {
              "setFlag": {
                "key": "fiac_hailed",
                "value": true
              }
            },
            {
              "queueNode": {
                "nodeId": "n_fiac_silent",
                "afterSeconds": 16
              }
            }
          ]
        },
        {
          "id": "o_fiac_free",
          "text": "Weapons free on that contact.",
          "requires": {
            "contactClassified": {
              "id": "c_fiac_1",
              "min": 75
            }
          },
          "effects": [
            {
              "setFlag": {
                "key": "fiac_resolved",
                "value": true
              }
            },
            {
              "setRoe": {
                "level": "free"
              }
            },
            {
              "queueNode": {
                "nodeId": "n_roe_free",
                "afterSeconds": 2
              }
            }
          ]
        },
        {
          "id": "o_fiac_wait",
          "text": "Hold. Keep tracking.",
          "effects": [
            {
              "setFlag": {
                "key": "fiac_resolved",
                "value": true
              }
            }
          ]
        }
      ]
    },
    {
      "id": "n_fiac_no_flinch",
      "speaker": "esm",
      "trigger": {
        "flag": "never_fires_on_its_own",
        "is": true
      },
      "text": "He took the beam and did not flinch, Captain. No turn, no slow-down. A fisherman lit up by a cruiser changes course. This one didn't."
    },
    {
      "id": "n_fiac_silent",
      "speaker": "cic",
      "trigger": {
        "flag": "never_fires_on_its_own",
        "is": true
      },
      "text": "Three calls, three channels, nothing back. Still closing, still on the same bearing to the tanker."
    },
    {
      "id": "n_roe_free",
      "speaker": "xo",
      "trigger": {
        "flag": "never_fires_on_its_own",
        "is": true
      },
      "priority": 9,
      "text": "Weapons free, aye. For the log, Captain: that authority is yours and the board will read it back to you either way."
    },
    {
      "id": "n_fiac_reveal",
      "speaker": "cic",
      "trigger": {
        "contactWithin": {
          "id": "c_fiac_1",
          "nm": 6
        }
      },
      "priority": 9,
      "text": "Visual from the bridge wing \u2014 she's carrying racks on the foredeck and there are men on them. That is not a fishing boat.",
      "focus": [
        "c_fiac_1"
      ],
      "effects": [
        {
          "revealTruth": {
            "id": "c_fiac_1"
          }
        },
        {
          "setFlag": {
            "key": "fiac_unmasked",
            "value": true
          }
        }
      ]
    },
    {
      "id": "n_fiac_release",
      "speaker": "tao",
      "trigger": {
        "all": [
          {
            "flag": "fiac_unmasked",
            "is": true
          },
          {
            "contactWithin": {
              "id": "c_fiac_1",
              "nm": 6
            }
          },
          {
            "not": {
              "contactDestroyed": {
                "id": "c_fiac_1"
              }
            }
          }
        ]
      },
      "priority": 10,
      "text": "Captain. He is inside gun range of our charge.",
      "focus": [
        "c_fiac_1",
        "c_argo"
      ],
      "timeoutSeconds": 12,
      "defaultOption": "o_rel_hold",
      "options": [
        {
          "id": "o_rel_free",
          "text": "Batteries release. Take him.",
          "requires": {
            "contactClassified": {
              "id": "c_fiac_1",
              "min": 75
            }
          },
          "effects": [
            {
              "setFlag": {
                "key": "auth.release.c_fiac_1",
                "value": true
              }
            },
            {
              "setRoe": {
                "level": "free"
              }
            },
            {
              "setFlag": {
                "key": "released_on_fiac",
                "value": true
              }
            }
          ]
        },
        {
          "id": "o_rel_interpose",
          "text": "Put us between him and the tanker.",
          "effects": [
            {
              "setFlag": {
                "key": "interposed",
                "value": true
              }
            }
          ]
        },
